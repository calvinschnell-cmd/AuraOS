# ---- OpenAI (leave OPENAI_API_KEY empty for MOCK MODE: fixtures, no API calls) ----
OPENAI_API_KEY=
# Override the scoring/roast model (default gpt-4o-mini, see lib/config.ts)
OPENAI_MODEL=
# Image detail for analysis: high (default, better boxes) | low (cheaper) | auto
OPENAI_IMAGE_DETAIL=high
# Max real analysis calls per day (default 600)
DAILY_SCAN_CAP=600
# Timezone that defines "today" for caps and ranks (default America/New_York)
KIOSK_TIMEZONE=America/New_York
# List prices for the debug overlay's spend estimate, USD per 1M tokens (gpt-4o-mini)
OPENAI_INPUT_USD_PER_M=0.15
OPENAI_OUTPUT_USD_PER_M=0.6

# ---- Local garment segmenter (ml-service/, `npm run ml`) ----
# Default http://127.0.0.1:8001. "off" skips it; if it is down, analysis scores the image alone.
ML_SERVICE_URL=
# Garment classifier: local (ML_SERVICE_URL) | remote (CLASSIFIER_URL) | skip. deploy.sh sets skip on the server.
CLASSIFIER_MODE=local
CLASSIFIER_URL=
# Phone scans (/scan): per-device and per-IP limits per window, upload size, share of DAILY_SCAN_CAP.
SCAN_RATE_LIMIT=5
SCAN_RATE_LIMIT_IP=30
SCAN_RATE_WINDOW_MIN=10
SCAN_MAX_UPLOAD_BYTES=5242880
MOBILE_DAILY_SCAN_CAP=400
# Keep the (EXIF-stripped) phone upload. Off: only the result and the face-blurred card are stored.
STORE_RAW_PHOTOS=false

# ---- Camera ----
# Part of the kiosk camera's name (e.g. CAM 313). Used until someone picks another camera (S on the kiosk, or /admin CAMERA).
KIOSK_CAMERA=

# ---- Operator ----
# Shared secret for /remote, /admin and DELETE /api/admin/entry/[id]
ADMIN_KEY=
# Aura Certificate printing (Stage 13). "true" to enable.
PRINTING_ENABLED=false

# ---- Gemini (second judge; empty = GPT judges alone) ----
GEMINI_API_KEY=
# Override the Gemini judge model (default gemini-3.8-flash)
GEMINI_MODEL=

# ---- ElevenLabs (spoken verdicts/roasts; empty = browser voice) ----
ELEVENLABS_API_KEY=
# Voice to use (default: a stock ElevenLabs voice, see lib/config.ts)
ELEVENLABS_VOICE_ID=

# ---- Tiger Data (TimescaleDB/Postgres: scans, leaderboard, history; empty = in-memory) ----
# postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
TIGER_DATABASE_URL=

# ---- Public URL (share links, NFT metadata). Empty = the kiosk's own origin ----
PUBLIC_BASE_URL=

# ---- Solana badges (devnet, custodial compressed NFTs; see `npm run solana:setup`) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
# "true" to mint a badge for each claimed card (never blocks the card)
SOLANA_BADGES_ENABLED=false
